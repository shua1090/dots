#!/usr/bin/env bash

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"
FONT="${SKETCHYBAR_FONT:-Hack Nerd Font}"
MAX_WORKSPACES="${SKETCHYBAR_MAX_WORKSPACES:-10}"

source "$CONFIG_DIR/colors.sh"

bar=(
  position=top
  height=32
  color="$BAR_BG"
  blur_radius=24
  shadow=off
  sticky=on
  padding_left=8
  padding_right=8
  margin=0
  y_offset=0
)
sketchybar --bar "${bar[@]}"

default=(
  updates=when_shown
  drawing=on
  padding_left=3
  padding_right=3
  icon.font="$FONT:Bold:13.0"
  icon.color="$FG"
  icon.padding_left=7
  icon.padding_right=5
  label.font="$FONT:Medium:11.5"
  label.color="$FG"
  label.padding_left=2
  label.padding_right=7
  background.drawing=on
  background.color="$BG"
  background.height=24
  background.corner_radius=7
  background.border_width=1
  background.border_color="$BORDER"
)
sketchybar --default "${default[@]}"

sketchybar --add event paneru_update

# Paneru virtual workspaces are fixed slots so event updates only repaint items.
workspace_items=()
for sid in $(seq 1 "$MAX_WORKSPACES"); do
  item="space.$sid"
  workspace_items+=("$item")
  sketchybar --add item "$item" left \
    --set "$item" \
      drawing=off \
      icon="$sid" \
      icon.padding_left=7 \
      icon.padding_right=7 \
      label.drawing=off \
      label.font="$FONT:Regular:13.0" \
      label.padding_left=0 \
      label.padding_right=7 \
      click_script="$PLUGIN_DIR/paneru.sh click $sid"
done

sketchybar --add bracket paneru.workspaces "${workspace_items[@]}" \
  --set paneru.workspaces \
    background.drawing=on \
    background.color="$BG" \
    background.height=26 \
    background.corner_radius=8 \
    background.border_width=1 \
    background.border_color="$BORDER"

sketchybar --add item paneru.status left \
  --set paneru.status \
    drawing=off \
    icon=󰖲 \
    icon.color="$RED" \
    label="Paneru offline" \
    label.color="$RED" \
    click_script="paneru start >/dev/null 2>&1"

sketchybar --add item front_app left \
  --set front_app \
    icon=󰣆 \
    icon.color="$BLUE" \
    label="Desktop" \
    label.max_chars=46 \
    scroll_texts=off \
    background.drawing=off \
    label.color="$FG" \
    click_script="/usr/bin/open -a 'Mission Control'"

# One hidden observer owns all Paneru refreshes and periodic self-healing.
sketchybar --add item paneru.refresh left \
  --set paneru.refresh \
    drawing=off \
    updates=on \
    update_freq=30 \
    script="$PLUGIN_DIR/paneru.sh refresh" \
  --subscribe paneru.refresh \
    paneru_update \
    front_app_switched \
    system_woke \
    display_change

sketchybar --add item clock right \
  --set clock \
    icon=󰥔 \
    icon.color="$BLUE" \
    update_freq=20 \
    script="$PLUGIN_DIR/clock.sh" \
    click_script="$PLUGIN_DIR/clock.sh calendar"

sketchybar --add item battery right \
  --set battery \
    icon= \
    icon.color="$GREEN" \
    update_freq=90 \
    script="$PLUGIN_DIR/battery.sh" \
    click_script="$PLUGIN_DIR/battery.sh settings" \
  --subscribe battery power_source_change system_woke

sketchybar --add item wifi right \
  --set wifi \
    icon=󰖩 \
    icon.color="$CYAN" \
    label.max_chars=16 \
    update_freq=45 \
    script="$PLUGIN_DIR/wifi.sh" \
    click_script="$PLUGIN_DIR/wifi.sh settings" \
  --subscribe wifi wifi_change system_woke

sketchybar --add item volume right \
  --set volume \
    icon=󰕾 \
    icon.color="$MAGENTA" \
    script="$PLUGIN_DIR/volume.sh" \
    click_script="$PLUGIN_DIR/volume.sh click" \
  --subscribe volume volume_change

sketchybar --add item cpu right \
  --set cpu \
    icon= \
    icon.color="$YELLOW" \
    update_freq=6 \
    script="$PLUGIN_DIR/cpu.sh" \
    click_script="/usr/bin/open -a 'Activity Monitor'"

sketchybar --add bracket system.status cpu volume wifi battery \
  --set system.status \
    background.drawing=on \
    background.color="$BG" \
    background.height=26 \
    background.corner_radius=8 \
    background.border_width=1 \
    background.border_color="$BORDER"

nohup "$PLUGIN_DIR/paneru_watch.sh" >/dev/null 2>&1 &

sketchybar --hotload true
sketchybar --trigger paneru_update
sketchybar --update
